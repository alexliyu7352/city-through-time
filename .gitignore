.venv/
cities/*/build/
cities/*/dist/
__pycache__/
*.mp4
*.wav
/local/
node_modules/
/internal/
cities/*/assets/ref/
cities/*/research/*_refs/
/.agents/
# generated: the entry page's index (tools/registry.mjs; CI builds it for GitHub Pages)
/cities.json
# generated: the site as published (tools/site.mjs)
/_site/
# a contributed city brings text only; its film, pictures, music and footage live on outside hosts
cities/**/*.jpg
cities/**/*.jpeg
cities/**/*.png
cities/**/*.webp
cities/**/*.gif
cities/**/*.tif
cities/**/*.tiff
cities/**/*.pdf
cities/**/*.mp3
cities/**/*.m4a
cities/**/*.flac
cities/**/*.ogg
cities/**/*.webm
cities/**/*.mov
cities/**/*.zip
# except the example city, kept whole so the project can be followed end to end: its pictures and poster (not its clips,
# which make.sh cuts from the originals, nor the modelling references)
!cities/xianyang/**/*.jpg
!cities/xianyang/**/*.png
!cities/xianyang/**/*.webp
cities/*/assets/ref/
# and its web bundle (tools/web.py), so the entry page plays it straight from GitHub Pages
!cities/xianyang/web/**
